diff --git a/QuestHomeEditor/CMakeLists.txt b/QuestHomeEditor/CMakeLists.txt
index b1f7c80..d3879d1 100644
--- a/QuestHomeEditor/CMakeLists.txt
+++ b/QuestHomeEditor/CMakeLists.txt
@@ -319,6 +319,29 @@ else()
     target_link_libraries(hsl_cook PRIVATE Threads::Threads m)
 endif()
 
+# ── hsl_extract — headless official-env → glTF 2.0 extractor (no Vulkan/GLFW) ──
+# Reuses SceneLoader + gltf_export to dump a modern (V205) Meta env APK to glTF for daoshu.
+add_executable(hsl_extract src/tools/hsl_extract.cpp src/cook/hzanim_acl.cpp src/cook/physx_navmesh.cpp src/cook/embedded_assets.cpp src/impl/stb_image_impl.c)
+target_include_directories(hsl_extract PRIVATE
+    "${MINIZ_DIR}"
+    "${STB_DIR}"
+    "${astcenc_SOURCE_DIR}/Source"
+    "${CMAKE_SOURCE_DIR}"
+    "${CMAKE_SOURCE_DIR}/src"
+    "${CMAKE_SOURCE_DIR}/third_party/acl/includes"
+    "${CMAKE_SOURCE_DIR}/third_party/rtm/includes"
+)
+target_link_libraries(hsl_extract PRIVATE miniz ${ASTCENC_LIB})
+if(HSR_HAVE_PHYSX)
+    target_link_libraries(hsl_extract PRIVATE hsr_physx)
+endif()
+if(WIN32)
+    target_compile_definitions(hsl_extract PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN _CRT_SECURE_NO_WARNINGS)
+    target_link_libraries(hsl_extract PRIVATE bcrypt crypt32)
+else()
+    target_link_libraries(hsl_extract PRIVATE Threads::Threads m)
+endif()
+
 option(HSR_BUILD_TESTS "Build Quest Home Editor regression tests" ON)
 if(HSR_BUILD_TESTS)
     enable_testing()
