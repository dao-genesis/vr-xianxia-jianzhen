diff --git a/QuestHomeEditor/src/loaders/scene_loader.h b/QuestHomeEditor/src/loaders/scene_loader.h
index 11d0b06..3f9365f 100644
--- a/QuestHomeEditor/src/loaders/scene_loader.h
+++ b/QuestHomeEditor/src/loaders/scene_loader.h
@@ -366,13 +366,23 @@ public:
             }
         }
 
-        // Helper: resolve any AssetKey → path string (tries real pkg then pkg=0).
+        // Last-resort index by ingestion id alone. Some refs (notably shellconfig's
+        // firstWorldAssetId in current-gen envs — haven2025/home_c25) carry tgt=0
+        // ("unspecified"), while the manifest entry has a real tgt. The ingestion id is a
+        // large unique hash, so an ing-only match recovers the asset. Only consulted after
+        // exact (pkg,ing,tgt) and (0,ing,tgt) both miss, so it never changes working lookups.
+        std::unordered_map<u64, const std::string*> ingIndex;
+        for (auto& kv : assetMap) if (kv.first.pkg != 0) ingIndex.emplace(kv.first.ing, &kv.second);
+
+        // Helper: resolve any AssetKey → path string (tries real pkg then pkg=0, then ing-only).
         auto resolve = [&](const AssetKey& k) -> const std::string* {
             auto it = assetMap.find(k);
             if (it != assetMap.end()) return &it->second;
             AssetKey k0 = k; k0.pkg = 0;
             it = assetMap.find(k0);
             if (it != assetMap.end()) return &it->second;
+            auto ii = ingIndex.find(k.ing);
+            if (ii != ingIndex.end()) return ii->second;
             return nullptr;
         };
 
